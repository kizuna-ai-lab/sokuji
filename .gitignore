.superpowers/
# Playwright MCP scratch: page dumps and screenshots from interactive browser
# sessions. This was previously a list of individual filenames, which only
# covered the dumps that existed the day it was written — every later session
# produced untracked files that a `git add` then swept into a commit. Ignore
# the directory instead.
/.playwright-mcp/

# Local test-run output (`npm run test > test-results.txt`)
/test-results.txt
/pocket-mirrors/

# OmniVoice TTS spike scratch (models, samples) — not committed
.spike/

# OmniVoice re-export toolchain venv (build-time, not committed)
scripts/reexport-omnivoice/.venv/
scripts/reexport-omnivoice/out/
scripts/reexport-omnivoice/.venv
__pycache__/

# Architecture-review screenshots (scratch, same batch as .playwright-mcp/)
/arch-review-*.png

# Manual PalabraAI probe harness — drives the real PalabraAIClient against the
# live API in a browser and tees the LiveKit signalling socket to print each
# offer/answer SessionDescription.id. Kept locally for re-testing whenever
# Palabra upgrades their LiveKit server (which is what pins livekit-client to an
# exact version); takes credentials via query string, so never commit it.
/palabra-probe/

# Per-application capture helpers (issue #335). Build artifacts: produced by
# native/audio-host/*/build.* and by CI before packaging, never committed.
# Their absence is not fatal - the app falls back to whole-system capture.
resources/bin/win32-x64/sokuji-audio-host.exe
resources/bin/darwin-arm64/sokuji-audio-host
resources/bin/darwin-x64/sokuji-audio-host
native/audio-host/*/out/

# native super-project build outputs
native/build/
native/python/sokuji_native/_native/
native/python/dist/
