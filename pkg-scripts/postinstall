#!/bin/sh

# Sokuji PKG Installer - Postinstall Script
# Installs the Sokuji Virtual Audio driver

echo "Sokuji postinstall: Starting installation..."

# Set correct permissions on the installed app.
#
# Ownership matters for auto-update, not just for permissions. The installer
# runs as root, so without this the bundle lands as root:wheel and Squirrel.Mac
# -- which runs as the invoking user and never escalates privileges -- cannot
# replace it. Handing it to the console user is what drag-installed apps look
# like anyway (Brave, Cursor and Firefox all install user-owned).
# See docs/build/macos-auto-update.md.
if [ -d "/Applications/Sokuji.app" ]; then
    echo "Sokuji postinstall: Setting app permissions..."
    chmod -R 755 /Applications/Sokuji.app

    CONSOLE_USER=$(stat -f%Su /dev/console 2>/dev/null)
    if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
        echo "Sokuji postinstall: Handing the app bundle to $CONSOLE_USER so updates can replace it..."
        chown -R "$CONSOLE_USER" /Applications/Sokuji.app || \
            echo "Sokuji postinstall: WARNING - chown failed; in-app updates will not be able to replace the bundle"
    else
        echo "Sokuji postinstall: WARNING - no console user found; leaving the bundle root-owned"
    fi
fi

# Install the virtual audio driver from the app bundle
DRIVER_SOURCE="/Applications/Sokuji.app/Contents/Resources/resources/drivers/SokujiVirtualAudio.driver"
DRIVER_DEST="/Library/Audio/Plug-Ins/HAL/SokujiVirtualAudio.driver"

# Ensure HAL plugins directory exists
HAL_DIR="/Library/Audio/Plug-Ins/HAL"
if [ ! -d "$HAL_DIR" ]; then
    echo "Sokuji postinstall: Creating HAL plugins directory..."
    mkdir -p "$HAL_DIR"
    if [ $? -ne 0 ]; then
        echo "Sokuji postinstall: ERROR - Failed to create HAL plugins directory"
        exit 1
    fi
    chown root:wheel "$HAL_DIR"
    chmod 755 "$HAL_DIR"
fi

if [ -d "$DRIVER_SOURCE" ]; then
    # PackageKit runs this script twice per install: electron-builder lists it
    # both as the package's postinstall and as the Sokuji.app component's (see
    # the pkg's PackageInfo). The second run used to delete the driver the first
    # had just installed, a moment after the first restarted CoreAudio, so the
    # surviving coreaudiod could scan this directory while the driver was missing
    # and publish no device until the next restart. So an identical driver is
    # left alone, the directory is never without one, and CoreAudio restarts only
    # after a change. See electron/macos-driver-install.consistency.test.js.
    if [ -d "$DRIVER_DEST" ] && diff -rq "$DRIVER_SOURCE" "$DRIVER_DEST" >/dev/null 2>&1; then
        echo "Sokuji postinstall: Virtual audio driver already installed and unchanged"
    else
        echo "Sokuji postinstall: Installing virtual audio driver..."

        # Stage the copy under a name HAL does not load, then move it into place.
        # The installed driver is removed only once the staged copy is complete
        # and correctly owned: a copy that fails halfway, on a full disk say,
        # must not turn a working virtual microphone into a missing one.
        STAGING="$HAL_DIR/SokujiVirtualAudio.driver.installing"
        rm -rf "$STAGING"
        echo "Sokuji postinstall: Copying driver to $DRIVER_DEST..."
        if ! cp -R "$DRIVER_SOURCE" "$STAGING" || \
           ! chown -R root:wheel "$STAGING" || \
           ! chmod -R 755 "$STAGING"; then
            rm -rf "$STAGING"
            echo "Sokuji postinstall: ERROR - Failed to stage the virtual audio driver; the installed one is unchanged"
            exit 1
        fi

        # Swap it in, keeping the old driver aside until the swap has worked, so
        # a move that fails restores it rather than leaving no driver at all.
        PREVIOUS="$HAL_DIR/SokujiVirtualAudio.driver.previous"
        rm -rf "$PREVIOUS"
        if [ -d "$DRIVER_DEST" ] && ! mv "$DRIVER_DEST" "$PREVIOUS"; then
            rm -rf "$STAGING"
            echo "Sokuji postinstall: ERROR - Failed to move the installed virtual audio driver aside; it is unchanged"
            exit 1
        fi
        if ! mv "$STAGING" "$DRIVER_DEST"; then
            [ -d "$PREVIOUS" ] && mv "$PREVIOUS" "$DRIVER_DEST"
            rm -rf "$STAGING"
            echo "Sokuji postinstall: ERROR - Failed to move the new virtual audio driver into place; the installed one was restored"
            exit 1
        fi
        rm -rf "$PREVIOUS"

        # Restart CoreAudio to load the driver
        echo "Sokuji postinstall: Restarting CoreAudio to load driver..."
        # Try multiple methods to ensure CoreAudio restarts regardless of permission level
        killall coreaudiod 2>/dev/null || \
        launchctl kickstart -k system/com.apple.audio.coreaudiod 2>/dev/null || \
        launchctl kill SIGTERM system/com.apple.audio.coreaudiod 2>/dev/null || true

        echo "Sokuji postinstall: Virtual audio driver installed successfully"
    fi
else
    echo "Sokuji postinstall: Warning - Virtual audio driver not found in app bundle"
fi

echo "Sokuji postinstall: Installation completed"
exit 0